{
    "name": "roundly-consulting/geolocation-for-laravel",
    "description": "Resolve a client's location and travel distance through pluggable geolocation providers for Laravel.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "geolocation",
        "ip-geolocation",
        "geocoding"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/geolocation-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/geolocation-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "ext-phar": "*",
        "ext-zlib": "*",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "roundly-consulting/enums-for-laravel": "^1.0",
        "roundly-consulting/http-client-rate-limits-for-laravel": "^1.0",
        "roundly-consulting/package-toolkit-for-laravel": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "roundly-consulting/testing-for-laravel": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Geolocation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Geolocation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Geolocation\\GeolocationServiceProvider"
            ],
            "aliases": {
                "Geolocation": "RoundlyConsulting\\Geolocation\\Facades\\Geolocation"
            }
        }
    }
}
